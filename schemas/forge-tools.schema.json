{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge MCP tool schemas",
  "version": 1,
  "generatedAt": "deterministic",
  "tools": {
    "forge_credential_list": {
      "title": "List credential profiles",
      "description": "List the tenant credential profiles. Secrets and encrypted payloads are never returned.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "forge_credential_create": {
      "title": "Create credential profile",
      "description": "Encrypt and store a Cloudflare API token as a named tenant profile. The secret is never returned or logged.",
      "sideEffect": "external",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "provider": {
            "type": "string",
            "const": "cloudflare"
          },
          "secret": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          },
          "metadata": {
            "default": {},
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            },
            "additionalProperties": false
          },
          "make_active": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "provider",
          "secret",
          "metadata",
          "make_active"
        ],
        "additionalProperties": false
      }
    },
    "forge_credential_update": {
      "title": "Update credential profile",
      "description": "Rename, replace, or update the metadata of a credential profile. Replacing a secret resets validation state.",
      "sideEffect": "external",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "credential_profile_id": {
            "type": "string",
            "pattern": "^crp_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "secret": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          },
          "metadata": {
            "default": {},
            "type": "object",
            "properties": {
              "account_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            },
            "additionalProperties": false
          },
          "make_active": {
            "type": "boolean"
          }
        },
        "required": [
          "credential_profile_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_credential_delete": {
      "title": "Delete credential profile",
      "description": "Permanently delete a tenant credential profile.",
      "sideEffect": "destructive",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "credential_profile_id": {
            "type": "string",
            "pattern": "^crp_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "credential_profile_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_credential_switch": {
      "title": "Switch credential profile",
      "description": "Select a profile for this MCP session and mark it active for the tenant.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "credential_profile_id": {
            "type": "string",
            "pattern": "^crp_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "credential_profile_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_credential_validate": {
      "title": "Validate credential profile",
      "description": "Decrypt a profile only for its provider validation request, then persist its validation state.",
      "sideEffect": "external",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "credential_profile_id": {
            "type": "string",
            "pattern": "^crp_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "credential_profile_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_workspace_reconcile": {
      "title": "Reconcile workspace recovery state",
      "description": "Read the checked-out Git state, reconcile durable metadata, and report whether the current Forge commit has been pushed.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "workspace_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_cloudflare_deploy": {
      "title": "Deploy with Cloudflare Wrangler",
      "description": "Deploy the workspace with pnpm exec wrangler using the selected Cloudflare profile for this one approved command. The API token is redacted from all results and is never persisted in the sandbox.",
      "sideEffect": "external",
      "approval": "required",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "credential_profile_id": {
            "type": "string",
            "pattern": "^crp_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "config_path": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^\\/workspace\\/repo\\/.*"
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_repository_list": {
      "title": "List authorized repositories",
      "description": "List GitHub repositories currently authorized through the Forge GitHub App for this account.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
