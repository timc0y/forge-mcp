{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge MCP tool schemas",
  "version": 1,
  "generatedAt": "deterministic",
  "tools": {
    "forge_repository_list": {
      "title": "List authorized repositories",
      "description": "List GitHub repositories currently authorized through the Forge GitHub App for this account.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "forge_task_start": {
      "title": "Start a durable task",
      "description": "Create a durable coding-session record that survives MCP reconnects, context compression and container sleep. Cheap: creates NO container. Call this first for any coherent piece of work, then attach one workspace later only when execution is needed.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "provider",
              "owner",
              "name"
            ],
            "additionalProperties": false
          },
          "base_ref": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "decisions": {
            "default": [],
            "maxItems": 40,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "non_goals": {
            "default": [],
            "maxItems": 40,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "likely_paths": {
            "default": [],
            "maxItems": 40,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          }
        },
        "required": [
          "repository",
          "base_ref",
          "goal",
          "decisions",
          "non_goals",
          "likely_paths"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "__schema1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "__schema2": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "forge_task_get": {
      "title": "Get a durable task",
      "description": "Return the full durable task record including branch, workspace, previews, files read and changed, checks and evidence ids. Read-only and container-free.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_task_summary": {
      "title": "Summarize a durable task",
      "description": "Return a compact reconnect summary that lets a fresh turn resume without replaying the session: goal, decisions, non-goals, state, files, checks, evidence, outstanding work and the next recommended action. Excludes source, full logs, diffs and secrets. Container-free.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_task_list": {
      "title": "List durable tasks",
      "description": "List recent durable tasks for the account, most recently updated first, optionally filtered by state. Container-free.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "planning",
              "ready",
              "coding",
              "validating",
              "previewing",
              "reviewing",
              "awaiting-approval",
              "complete",
              "failed",
              "cancelled"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "forge_task_finish": {
      "title": "Finish a durable task",
      "description": "Move a durable task to a terminal state (complete, failed or cancelled). The task record and its evidence remain retrievable afterwards.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "complete",
              "failed",
              "cancelled"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "task_id",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "forge_review": {
      "title": "Review a site with Parallax",
      "description": "The easiest and cheapest Forge path. Capture screenshot and accessibility evidence from an existing URL without starting a container, ready for a strict Parallax review. Each cell carries a structure-health signal (structureSummary and evidence[].accessibility.structure) that flags heading defects the screenshot hides — stacked title-on-title headings, empty or duplicated headings and skipped levels — so those must be resolved or explicitly accepted before the review passes.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "captures": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "viewports": {
            "default": [
              {
                "id": "phone",
                "width": 390,
                "height": 844
              },
              {
                "id": "desktop",
                "width": 1440,
                "height": 900
              }
            ],
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "full_page": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "captures",
          "viewports",
          "full_page"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "state": {
                "default": "entry",
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "selection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "path",
              "state"
            ],
            "additionalProperties": false
          },
          "__schema1": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 1920
              },
              "height": {
                "type": "integer",
                "minimum": 320,
                "maximum": 2160
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "forge_workspace_create": {
      "title": "Create Forge workspace",
      "description": "Create a disposable isolated workspace from an authorized repository. Returns immediately with state 'requested'; poll forge_workspace_get until state is 'ready' (usually under a minute) before using it. idempotency_key must be unique per distinct workspace.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "provider",
              "owner",
              "name"
            ],
            "additionalProperties": false
          },
          "ref": {
            "default": "main",
            "type": "string"
          },
          "runtime": {
            "default": "node-22",
            "type": "string",
            "enum": [
              "node-22",
              "node-24",
              "python-3.13",
              "general-purpose"
            ]
          },
          "persistence": {
            "default": "ephemeral",
            "type": "string",
            "const": "ephemeral"
          },
          "bootstrap": {
            "default": true,
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "repository",
          "ref",
          "runtime",
          "persistence",
          "bootstrap",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_workspace_get": {
      "title": "Get Forge workspace",
      "description": "Return lifecycle, repository, revision, processes, previews, snapshot and outstanding state for one workspace.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "workspace_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_context_get": {
      "title": "Select bounded repository context",
      "description": "Rank the most relevant repository files for a goal deterministically (no embeddings, no model). Returns paths with reasons, governing instructions, adjacent tests, package context and warnings — never file contents. The client decides what to read. Cheap.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "task_id": {
            "type": "string",
            "pattern": "^task_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "root": {
            "default": "/workspace/repo",
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "max_results": {
            "default": 12,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "categories": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "workspace_id",
          "goal",
          "root",
          "max_results"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "enum": [
              "source",
              "tests",
              "docs",
              "config"
            ]
          }
        }
      }
    },
    "forge_diff_metadata": {
      "title": "Summarize the outgoing diff",
      "description": "Return deterministic compact metadata over the outgoing diff (changed files, additions/deletions, changed exports, tests, config, migrations, possible secret exposure, risk areas and suggested hunks) plus targeted verification suggestions. Syntax-only: inspect the raw diff via forge_git_outgoing_diff before any Git mutation.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "workspace_id",
          "base"
        ],
        "additionalProperties": false
      }
    },
    "forge_files_tree": {
      "title": "List workspace files",
      "description": "Return a bounded, Git-aware file tree rooted inside /workspace.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "path": {
            "default": "/workspace/repo",
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "depth": {
            "default": 4,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "limit": {
            "default": 1000,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "workspace_id",
          "path",
          "depth",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "forge_files_read": {
      "title": "Read workspace file(s)",
      "description": "Read one file (path) or several at once (paths) as bounded text, each with a content hash for conflict-safe edits. Reading several in one call saves round trips. start_line/end_line and max_bytes apply to each file.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "path": {
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "paths": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "start_line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "end_line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "max_bytes": {
            "default": 200000,
            "type": "integer",
            "minimum": 1,
            "maximum": 500000
          }
        },
        "required": [
          "workspace_id",
          "max_bytes"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "pattern": "^\\/workspace.*"
          }
        }
      }
    },
    "forge_files_write": {
      "title": "Write workspace file",
      "description": "Create or overwrite a file with its full content — simpler and more reliable than a unified diff for whole-file changes. Pass expected_sha256 (from forge_files_read) for a conflict-safe overwrite; omit it to create a new file. Parent directories are created automatically. idempotency_key must be unique per distinct write.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "path": {
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "content": {
            "type": "string",
            "maxLength": 1000000
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "path",
          "content",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_files_patch": {
      "title": "Apply file patch",
      "description": "Apply a unified diff inside the repository. Best for surgical multi-hunk edits; for whole-file rewrites prefer forge_files_write (agents often miscount diff context). idempotency_key must be unique per distinct patch.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "patch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "patch",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_shell_exec": {
      "title": "Execute bounded command",
      "description": "Execute a foreground command in an explicit directory with timeout, output and network-policy bounds. Risky commands return a real user approval URL. idempotency_key must be unique per distinct command.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "cwd": {
            "default": "/workspace/repo",
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "timeout_ms": {
            "default": 300000,
            "type": "integer",
            "minimum": 100,
            "maximum": 900000
          },
          "environment": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "network_policy": {
            "default": "development",
            "type": "string",
            "enum": [
              "deny_all",
              "package_install",
              "development",
              "custom_allowlist",
              "unrestricted_with_approval"
            ]
          },
          "output_limit_bytes": {
            "default": 200000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 1000000
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          }
        },
        "required": [
          "workspace_id",
          "command",
          "cwd",
          "timeout_ms",
          "environment",
          "network_policy",
          "output_limit_bytes",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_process_start": {
      "title": "Start background process",
      "description": "Start a long-running process such as a development server and return a Forge process identifier immediately. idempotency_key must be unique per distinct process.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "cwd": {
            "default": "/workspace/repo",
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "environment": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "network_policy": {
            "default": "development",
            "type": "string",
            "enum": [
              "deny_all",
              "package_install",
              "development",
              "custom_allowlist"
            ]
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "command",
          "cwd",
          "environment",
          "network_policy",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_process_logs": {
      "title": "Read process logs",
      "description": "Read a bounded process-log page using an opaque cursor.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "process_id": {
            "type": "string",
            "pattern": "^proc_.*"
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "process_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_status": {
      "title": "Read Git status",
      "description": "Return structured working-tree and branch status for the workspace repository.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          }
        },
        "required": [
          "workspace_id"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_diff": {
      "title": "Read Git diff",
      "description": "Return a bounded unified diff for the working tree or staged changes.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "staged": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "workspace_id",
          "staged"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_branch_create": {
      "title": "Create Forge branch",
      "description": "Create and check out a local branch under the required forge/ namespace.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "branch": {
            "type": "string",
            "maxLength": 107,
            "pattern": "^forge\\/.*"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "branch",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_commit": {
      "title": "Commit workspace changes",
      "description": "Stage selected repository paths and create a commit attributed to forge-mcp[bot]. Omit message to auto-generate a conventional-commit message from the diff.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "paths": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "paths",
          "idempotency_key"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "forge_git_outgoing_diff": {
      "title": "Inspect outgoing Git change",
      "description": "Return the exact bounded diff and hash between the base branch and current Forge branch before approval.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "workspace_id",
          "base"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_push": {
      "title": "Push Forge branch",
      "description": "Push a non-default forge/ branch through the GitHub App credential proxy. A real user approval page is required.",
      "sideEffect": "external",
      "approval": "required",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "branch": {
            "type": "string",
            "maxLength": 107,
            "pattern": "^forge\\/.*"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "expected_diff_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "branch",
          "base",
          "expected_diff_hash",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_pull_request_create": {
      "title": "Create draft pull request",
      "description": "Create a draft GitHub pull request for an already pushed Forge branch. A real user approval page is required. Omit title to auto-generate a title and body from the branch diff.",
      "sideEffect": "external",
      "approval": "required",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "head": {
            "type": "string",
            "maxLength": 107,
            "pattern": "^forge\\/.*"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          }
        },
        "required": [
          "workspace_id",
          "head",
          "base",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "forge_preview_expose": {
      "title": "Expose private preview",
      "description": "Expose a running process through a short-lived Forge preview capability. Private is the default; public requires approval.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "process_id": {
            "type": "string",
            "pattern": "^proc_.*"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "access": {
            "default": "private",
            "type": "string",
            "enum": [
              "private",
              "tenant",
              "share-link",
              "public"
            ]
          },
          "ttl_seconds": {
            "default": 3600,
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "process_id",
          "port",
          "access",
          "ttl_seconds",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_review_capture": {
      "title": "Capture Parallax review evidence",
      "description": "Capture screenshot + accessibility evidence of a running Forge preview: one packet for bounded routes, states and viewports. Optionally give a capture `steps` to drive a real interaction (click/fill/press/wait) before the shot — that proves multi-step flows (open a menu, submit a form) a static screenshot cannot. Use forge_artifact_get to inspect each stored image. This is the only preview-evidence tool; there is no separate screenshot/accessibility/act tool.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preview_id": {
            "type": "string",
            "pattern": "^prv_.*"
          },
          "captures": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "viewports": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          }
        },
        "required": [
          "workspace_id",
          "preview_id",
          "captures",
          "viewports"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "state": {
                "default": "entry",
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "selection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "steps": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              }
            },
            "required": [
              "route",
              "state"
            ],
            "additionalProperties": false
          },
          "__schema1": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "navigate",
                  "click",
                  "fill",
                  "press",
                  "wait_for_selector",
                  "wait_for_text",
                  "wait",
                  "reload"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "value": {
                "type": "string",
                "maxLength": 10000
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "path": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 30000
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "__schema2": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "forge_artifact_get": {
      "title": "Get browser artifact",
      "description": "Return a stored Forge artifact to the MCP client. Image artifacts are returned as MCP image content for direct model inspection.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^art_.*"
          },
          "max_bytes": {
            "default": 2500000,
            "type": "integer",
            "minimum": 1,
            "maximum": 4000000
          }
        },
        "required": [
          "workspace_id",
          "artifact_id",
          "max_bytes"
        ],
        "additionalProperties": false
      }
    },
    "forge_workspace_destroy": {
      "title": "Destroy Forge workspace",
      "description": "Revoke previews and capabilities, stop processes, destroy the sandbox and mark the workspace destroyed.",
      "sideEffect": "destructive",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preserve_artifacts": {
            "default": true,
            "type": "boolean"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "preserve_artifacts",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    }
  }
}
