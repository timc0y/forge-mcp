    "forge_review": {
      "title": "Review a site with Parallax",
      "description": "The easiest and cheapest Forge path. Capture screenshot and accessibility evidence from an existing URL without starting a container, ready for a strict Parallax review.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "captures": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "viewports": {
            "default": [
              {
                "id": "phone",
                "width": 390,
                "height": 844
              },
              {
                "id": "desktop",
                "width": 1440,
                "height": 900
              }
            ],
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "full_page": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "captures",
          "viewports",
          "full_page"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "object",
            "properties": {
              "selection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "path": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "state": {
                "default": "entry",
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "selection",
              "path",
              "state"
            ],
            "additionalProperties": false
          },
          "__schema1": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 1920
              },
              "height": {
                "type": "integer",
                "minimum": 320,
                "maximum": 2160
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "forge_workspace_create": {
      "title": "Create Forge workspace",
      "description": "Create a disposable isolated workspace from an authorized repository. Returns immediately with the current lifecycle state and revision.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "github"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "provider",
              "owner",
              "name"
            ],
            "additionalProperties": false
          },
          "ref": {
            "default": "main",
            "type": "string"
          },
          "runtime": {
            "default": "node-22",
            "type": "string",
            "enum": [
              "node-22",
              "node-24",
              "python-3.13",
              "general-purpose"
            ]
          },
          "persistence": {
            "default": "ephemeral",
            "type": "string",
            "const": "ephemeral"
          },
          "bootstrap": {
            "default": true,
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "repository",
          "ref",
          "runtime",
          "persistence",
          "bootstrap",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
