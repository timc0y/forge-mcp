    "forge_shell_exec": {
      "title": "Execute bounded command",
      "description": "Execute a foreground command in an explicit directory with timeout, output and network-policy bounds. Risky commands return a real user approval URL.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "cwd": {
            "default": "/workspace/repo",
            "type": "string",
            "pattern": "^\\/workspace.*"
          },
          "timeout_ms": {
            "default": 300000,
            "type": "integer",
            "minimum": 100,
            "maximum": 900000
          },
          "environment": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "network_policy": {
            "default": "development",
            "type": "string",
            "enum": [
              "deny_all",
              "package_install",
              "development",
              "custom_allowlist",
              "unrestricted_with_approval"
            ]
          },
          "output_limit_bytes": {
            "default": 200000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 1000000
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          }
        },
        "required": [
          "workspace_id",
          "command",
          "cwd",
          "timeout_ms",
          "environment",
          "network_policy",
          "output_limit_bytes",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
