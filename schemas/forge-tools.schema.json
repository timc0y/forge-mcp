{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge MCP tool schemas",
  "version": 1,
  "generatedAt": "deterministic",
  "tools": {
    "forge_repositories": {
      "title": "Repositories",
      "description": "List or filter GitHub repositories authorized for Forge. Explains how to reconnect or grant access when a repository is missing.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    "forge_search": {
      "title": "Search repository",
      "description": "Search file paths and text directly in GitHub. Does not start compute.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "description": "Branch, tag, or commit SHA. Omit to use the repository default/current intent branch.",
            "$ref": "#/$defs/__schema0"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Repository-relative path."
          },
          "max_results": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "repository",
          "query",
          "max_results"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    },
    "forge_read": {
      "title": "Read repository",
      "description": "Read up to 20 files or directories directly from GitHub. Directory paths return a bounded listing; no compute is started.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "description": "Branch, tag, or commit SHA. Omit to use the repository default/current intent branch.",
            "$ref": "#/$defs/__schema0"
          },
          "paths": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "max_bytes": {
            "default": 200000,
            "type": "integer",
            "minimum": 1,
            "maximum": 500000
          }
        },
        "required": [
          "repository",
          "paths",
          "max_bytes"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "__schema1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Repository-relative path."
          }
        }
      }
    },
    "forge_edit": {
      "title": "Edit and commit",
      "description": "Make a small, bounded repository change. Forge creates or reuses an intent branch, commits to GitHub, and verifies the remote commit before reporting success. Command-created files are never saved by this tool.",
      "sideEffect": "external",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "description": "Branch, tag, or commit SHA. Omit to use the repository default/current intent branch.",
            "$ref": "#/$defs/__schema0"
          },
          "intent": {
            "description": "Required when starting a new intent branch; omit only when ref names an existing intent branch.",
            "$ref": "#/$defs/__schema1"
          },
          "base_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "files": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            },
            "description": "At most 10 files and 200 KB combined content (enforced by Forge)."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "idempotency_key": {
            "description": "Optional stable retry key. Omit for a new request.",
            "$ref": "#/$defs/__schema6"
          }
        },
        "required": [
          "repository",
          "files"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "__schema1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "__schema2": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Repository-relative path."
              },
              "content": {
                "description": "Whole new file content; null deletes the file.",
                "$ref": "#/$defs/__schema3"
              },
              "replace": {
                "description": "Unambiguous fragment replacements. Prefer this for existing files.",
                "$ref": "#/$defs/__schema4"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "__schema3": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200000
              },
              {
                "type": "null"
              }
            ]
          },
          "__schema4": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "__schema5": {
            "type": "object",
            "properties": {
              "old": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "new": {
                "type": "string",
                "maxLength": 100000
              },
              "all": {
                "type": "boolean"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "additionalProperties": false
          },
          "__schema6": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      }
    },
    "forge_run": {
      "title": "Run command",
      "description": "Run one command against the exact GitHub revision. Forge handles checkout and dependencies. File changes produced by commands are ephemeral and never committed automatically.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "description": "GitHub branch. Omit to use the repository default branch.",
            "$ref": "#/$defs/__schema0"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "cwd": {
            "default": "/workspace/repo",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "timeout_ms": {
            "default": 600000,
            "description": "Maximum command runtime. Forge returns a status URL when work outlives the host-safe synchronous window.",
            "$ref": "#/$defs/__schema1"
          },
          "idempotency_key": {
            "description": "Optional stable retry key. Omit for a new request.",
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "repository",
          "command",
          "cwd",
          "timeout_ms"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "__schema1": {
            "type": "integer",
            "minimum": 100,
            "maximum": 600000
          },
          "__schema2": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      }
    },
    "forge_screenshot": {
      "title": "Screenshot",
      "description": "Capture a public URL or owner/repo#ref at responsive breakpoints. Repository captures start and expose the preview internally; screenshots are returned inline when available.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Public URL or authorized repository reference: owner/repo or owner/repo#ref."
          },
          "paths": {
            "default": [
              "/"
            ],
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "viewports": {
            "default": [
              "phone",
              "desktop"
            ],
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "steps": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "full_page": {
            "default": false,
            "type": "boolean"
          },
          "time_budget_ms": {
            "default": 40000,
            "type": "integer",
            "minimum": 10000,
            "maximum": 40000
          }
        },
        "required": [
          "target",
          "paths",
          "viewports",
          "full_page",
          "time_budget_ms"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "__schema1": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "phone",
                  "tablet",
                  "desktop"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 3840
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 2160
                  }
                },
                "required": [
                  "id",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            ]
          },
          "__schema2": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "navigate",
                  "click",
                  "fill",
                  "press",
                  "wait_for_selector",
                  "wait_for_text",
                  "wait",
                  "reload"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "value": {
                "type": "string",
                "maxLength": 10000
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "path": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 30000
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "forge_environments": {
      "title": "Deployment environments",
      "description": "List saved deployment environments and readiness for a repository. Returns labels and providers only; secret values and mappings never leave Forge.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      }
    },
    "forge_deploy": {
      "title": "Deploy",
      "description": "Request deployment of an exact GitHub revision through a saved environment. Returns a deferred approval/status URL; Forge runs the approved deployment without another Chat call.",
      "sideEffect": "external",
      "approval": "deferred",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "description": "GitHub branch. Omit to use the repository default branch.",
            "$ref": "#/$defs/__schema0"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "idempotency_key": {
            "description": "Optional stable retry key. Omit for a new request.",
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "repository",
          "environment"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "__schema1": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      }
    },
    "forge_submit": {
      "title": "Submit for review",
      "description": "Seal an intent branch and submit its verified GitHub revision for deferred review and draft pull-request creation.",
      "sideEffect": "external",
      "approval": "deferred",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "Authorized GitHub repository, written owner/repo."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Exact forge/chat-* intent branch returned by forge_edit."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "maxLength": 60000
          },
          "idempotency_key": {
            "description": "Optional stable retry key. Omit for a new request.",
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "repository",
          "ref"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      }
    },
    "forge_status": {
      "title": "Status",
      "description": "Recover the latest Forge result for a repository/ref or durable operation ID. Never restarts work and is not required for normal flows.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "target": {
            "description": "owner/repo, owner/repo#ref, or operation ID from a prior receipt. Omit to recover the most recent operation.",
            "$ref": "#/$defs/__schema0"
          }
        },
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
