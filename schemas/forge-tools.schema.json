      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
