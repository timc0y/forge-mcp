            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "workspace_id",
          "base"
        ],
        "additionalProperties": false
      }
    },
    "forge_git_push": {
      "title": "Push Forge branch",
      "description": "Push a non-default forge/ branch through the GitHub App credential proxy. A real user approval page is required.",
      "sideEffect": "external",
      "approval": "required",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "branch": {
            "type": "string",
            "maxLength": 107,
            "pattern": "^forge\\/.*"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "expected_diff_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "branch",
          "base",
          "expected_diff_hash",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_pull_request_create": {
      "title": "Create draft pull request",
      "description": "Create a draft GitHub pull request for an already pushed Forge branch. A real user approval page is required.",
      "sideEffect": "external",
      "approval": "required",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "head": {
            "type": "string",
            "maxLength": 107,
            "pattern": "^forge\\/.*"
          },
          "base": {
            "default": "main",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "default": "",
            "type": "string",
            "maxLength": 60000
          },
          "approval_id": {
            "type": "string",
            "pattern": "^apr_.*"
          }
        },
        "required": [
          "workspace_id",
          "head",
          "base",
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "forge_preview_expose": {
      "title": "Expose private preview",
      "description": "Expose a running process through a short-lived Forge preview capability. Private is the default; public requires approval.",
      "sideEffect": "workspace",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "process_id": {
            "type": "string",
            "pattern": "^proc_.*"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "access": {
            "default": "private",
            "type": "string",
            "enum": [
              "private",
              "tenant",
              "share-link",
              "public"
            ]
          },
          "ttl_seconds": {
            "default": 3600,
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "process_id",
          "port",
          "access",
          "ttl_seconds",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "forge_review_capture": {
      "title": "Capture Parallax review evidence",
      "description": "Capture a versioned Parallax evidence packet for bounded selections, routes, states and viewports. Use forge_artifact_get to inspect each stored screenshot image.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preview_id": {
            "type": "string",
            "pattern": "^prv_.*"
          },
          "captures": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "viewports": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "workspace_id",
          "preview_id",
          "captures",
          "viewports"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "type": "object",
            "properties": {
              "selection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "route": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "state": {
                "default": "entry",
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "selection",
              "route",
              "state"
            ],
            "additionalProperties": false
          },
          "__schema1": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "forge_browser_screenshot": {
      "title": "Capture browser screenshot",
      "description": "Capture browser evidence from a Forge preview and persist it as an artifact bound to workspace revision and viewport.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preview_id": {
            "type": "string",
            "pattern": "^prv_.*"
          },
          "path": {
            "default": "/",
            "type": "string",
            "pattern": "^\\/.*"
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "full_page": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "workspace_id",
          "preview_id",
          "path",
          "viewport",
          "full_page"
        ],
        "additionalProperties": false
      }
    },
    "forge_browser_accessibility_tree": {
      "title": "Read browser accessibility tree",
      "description": "Capture the bounded accessibility tree for a Forge preview route at a selected viewport.",
      "sideEffect": "workspace",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preview_id": {
            "type": "string",
            "pattern": "^prv_.*"
          },
          "path": {
            "default": "/",
            "type": "string",
            "pattern": "^\\/.*"
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "workspace_id",
          "preview_id",
          "path",
          "viewport"
        ],
        "additionalProperties": false
      }
    },
    "forge_artifact_get": {
      "title": "Get browser artifact",
      "description": "Return a stored Forge artifact to the MCP client. Image artifacts are returned as MCP image content for direct model inspection.",
      "sideEffect": "none",
      "approval": "none",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^art_.*"
          },
          "max_bytes": {
            "default": 2500000,
            "type": "integer",
            "minimum": 1,
            "maximum": 4000000
          }
        },
        "required": [
          "workspace_id",
          "artifact_id",
          "max_bytes"
        ],
        "additionalProperties": false
      }
    },
    "forge_workspace_destroy": {
      "title": "Destroy Forge workspace",
      "description": "Revoke previews and capabilities, stop processes, destroy the sandbox and mark the workspace destroyed.",
      "sideEffect": "destructive",
      "approval": "policy",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^ws_[0-9a-hjkmnp-tv-z]{20,32}$"
          },
          "preserve_artifacts": {
            "default": true,
            "type": "boolean"
          },
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "workspace_id",
          "preserve_artifacts",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    }
  }
}
