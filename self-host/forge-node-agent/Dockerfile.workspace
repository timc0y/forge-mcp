# Base image for self-hosted Forge workspaces — the same idea as Forge Cloud's
# workspace container. Build once on the machine:
#   docker build -f Dockerfile.workspace -t forge-workspace:latest .
# Add whatever toolchains your repos need. A bigger image means fewer installs
# per workspace = faster builds, since the machine is always on.
FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential python3 python3-pip bash \
    && rm -rf /var/lib/apt/lists/*

# Node + pnpm ready to go (no cold download mid-build).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && corepack enable && corepack prepare pnpm@9 --activate

# Run as an unprivileged user (uid 1000) that owns /workspace. The agent starts
# every container with --user 1000:1000 --cap-drop ALL --no-new-privileges, so
# agent-authored code cannot escalate or touch the host.
RUN useradd -m -u 1000 forge \
    && mkdir -p /workspace \
    && chown -R 1000:1000 /workspace
WORKDIR /workspace
USER 1000
