# Base image for self-hosted Forge workspaces. Build once on the Mac mini:
#   docker build -f Dockerfile.workspace -t forge-workspace:latest .
# Add whatever toolchains your repos need (node, python, go, …). Bigger image =
# fewer installs per workspace = faster builds, since the machine is always on.
FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential python3 python3-pip bash \
    && rm -rf /var/lib/apt/lists/*

# Node via nvm-less install (adjust version as needed)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm

WORKDIR /workspace
