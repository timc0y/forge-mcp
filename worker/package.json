{
  "name": "@forge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --env development",
    "deploy": "pnpm typecheck && pnpm test && wrangler deploy --config wrangler.jsonc --env=\"\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test scripts/*.node-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "agents": "0.17.3",
    "jose": "6.2.9",
    "@shopify/liquid-html-parser": "2.10.0",
    "@lezer/markdown": "1.6.3",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "vitest": "5.0.3",
    "vite": "8.2.4",
    "wrangler": "4.149.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.32.2",
      "miniflare>undici": "7.30.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js-pure"
    ]
  }
}
