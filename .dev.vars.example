# Development only. Production uses OAuth 2.1 and environment-specific bindings.
FORGE_DEV_AUTH_TOKEN=replace-me
FORGE_CAPABILITY_SIGNING_KEY=replace-with-at-least-32-random-bytes
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me
# Optional PostHog product analytics only — not required for activity logs.
# Complete activity is D1 mcp_tool_calls + forge_observer_activity /app/live.
# POSTHOG_API_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# FORGE_POSTHOG_LIVE_EMBED_URL=https://us.posthog.com/embedded/your-sharing-token
